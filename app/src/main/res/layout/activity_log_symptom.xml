<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_log_symptom.xml -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".LogSymptomActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log a Symptom"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"
                android:textColor="@android:color/black"/>

        </RelativeLayout>

        <!-- Symptom Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Symptom Name"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/black"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_symptom_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., Headache, Fatigue"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <!-- Intensity Slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intensity"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:textStyle="bold"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_intensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="10"
            android:stepSize="1"
            android:value="5"
            app:labelBehavior="gone"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mild"
                android:layout_alignParentStart="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severe"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <!-- Date & Time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date &amp; Time"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_date_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="8dp"
            android:text="Select Date &amp; Time"/>

        <!-- Additional Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Additional Notes (Optional)"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_additional_notes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Any other details..."
            android:gravity="top"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_symptom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Symptom"
            android:backgroundTint="@android:color/black"
            android:textColor="@android:color/white"
            android:layout_marginTop="32dp"
            app:cornerRadius="12dp"
            android:padding="14dp"/>
    </LinearLayout>
</ScrollView>